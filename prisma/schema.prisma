// prisma/schema.prisma
datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  username     String   @unique
  passwordHash String?
  avatar       String?
  provider     String   @default("credentials") // "credentials" or "google"
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizedCircles   Circle[]             @relation("Organizer")
  circleMemberships  CircleMember[]
  sessionParticipants SessionParticipant[]
  chatMessages       ChatMessage[]
}

model Circle {
  id           String   @id @default(uuid())
  name         String
  description  String?
  workType     String   // "Deep Work", "Study", "Admin", "Creative"
  durationMins Int      @default(50)
  isStanding   Boolean  @default(false)
  timeSlot     String?  // e.g. "Mon 09:00 AM" or "Daily 02:00 PM"
  inviteCode   String   @unique @default(uuid())
  streak       Int      @default(0)
  organizerId  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizer User           @relation("Organizer", fields: [organizerId], references: [id], onDelete: Cascade)
  members   CircleMember[]
  sessions  Session[]
}

model CircleMember {
  id        String   @id @default(uuid())
  circleId  String
  userId    String
  role      String   @default("member") // "organizer", "member"
  joinedAt  DateTime @default(now())

  circle Circle @relation(fields: [circleId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([circleId, userId])
}

model Session {
  id           String   @id @default(uuid())
  circleId     String
  status       String   @default("scheduled") // "scheduled", "active", "completed"
  startTime    DateTime @default(now())
  endTime      DateTime
  durationMins Int
  streakAwarded Boolean @default(false)
  createdAt    DateTime @default(now())

  circle       Circle               @relation(fields: [circleId], references: [id], onDelete: Cascade)
  participants SessionParticipant[]
  chatMessages ChatMessage[]
}

model SessionParticipant {
  id         String   @id @default(uuid())
  sessionId  String
  userId     String
  goal       String?  // One-line goal: "What I'm finishing this session."
  cameraOn   Boolean  @default(false)
  status     String   @default("pending") // "pending", "done", "partial", "blocked"
  joinedAt   DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([sessionId, userId])
}

model ChatMessage {
  id        String   @id @default(uuid())
  sessionId String
  userId    String
  text      String
  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
}
